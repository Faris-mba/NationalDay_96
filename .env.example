# انسخ هذا الملف إلى .env.local واملأ القيم من لوحة تحكم Supabase
# Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# مفتاح العميل. تسمّيه Supabase "anon public" في المشاريع الأقدم،
# و"publishable key" في الأحدث (يبدأ بـ sb_publishable_).
# كلاهما المفتاح نفسه، واللعبة تقبل أيًّا من الاسمين التاليين:
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# اختياري: رابط الموقع المستخدم في توليد رمز QR.
# على Vercel يُشتق تلقائيًا من العنوان الحالي، لكن يمكن تثبيته هنا.
NEXT_PUBLIC_SITE_URL=

# كلمة مرور بسيطة لحماية شاشة الإعدادات (اختيارية)
NEXT_PUBLIC_HOST_PIN=
